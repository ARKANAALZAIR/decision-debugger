{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Debugger canonical output",
  "type": "object",
  "required": [
    "decision",
    "executive_state",
    "findings",
    "module_execution_matrix",
    "audit_integrity"
  ],
  "properties": {
    "decision": {
      "type": "object",
      "properties": {
        "statement": {},
        "objective": {},
        "constraints": {},
        "options": {},
        "owner": {},
        "decision_rights": {},
        "stakeholders": {},
        "time_horizon": {},
        "reversibility": {},
        "stakes": {},
        "mode": {}
      }
    },
    "executive_state": {
      "type": "object",
      "required": [
        "state",
        "assessment_confidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "INSUFFICIENT EVIDENCE",
            "CONTESTED",
            "FRAGILE",
            "CONDITIONAL",
            "ROBUST"
          ]
        },
        "assessment_confidence": {
          "enum": [
            "HIGH",
            "MODERATE",
            "LOW"
          ]
        },
        "primary_vulnerability": {
          "type": "string"
        },
        "decision_changing_finding": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "type",
          "primary_module",
          "related_modules",
          "decision_changing",
          "decision_link",
          "location",
          "problem",
          "evidence",
          "reasoning",
          "impact",
          "recommended_action",
          "provenance",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "reasoning": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "recommended_action": {
            "type": "string"
          },
          "decision_changing": {
            "enum": [
              "YES",
              "NO",
              "UNKNOWN"
            ]
          },
          "primary_module": {
            "type": "string"
          },
          "related_modules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "string"
          },
          "verification": {
            "enum": [
              "VERIFIED",
              "UNVERIFIED",
              "NOT AVAILABLE",
              "UNKNOWN"
            ]
          },
          "decision_link": {
            "type": "string"
          }
        }
      }
    },
    "evidence_audit": {
      "type": "array"
    },
    "assumptions": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "failure_modes": {
      "type": "array"
    },
    "scenarios": {
      "type": "array"
    },
    "alternatives": {
      "type": "array"
    },
    "feasibility": {
      "type": "object"
    },
    "stakeholder_agency": {
      "type": "object"
    },
    "reversibility": {
      "type": "object"
    },
    "decision_boundaries": {
      "type": "array"
    },
    "reassessment_triggers": {
      "type": "array"
    },
    "next_best_information": {
      "type": "array"
    },
    "ledger": {
      "type": "object"
    },
    "second_order_effects": {
      "type": "array"
    },
    "module_execution_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "class": {
            "enum": [
              "DIAGNOSTIC",
              "SYNTHESIS"
            ]
          },
          "status": {
            "oneOf": [
              {
                "enum": [
                  "ERROR FOUND",
                  "ERROR NOT FOUND",
                  "NOT ASSESSABLE",
                  "NOT APPLICABLE"
                ]
              },
              {
                "enum": [
                  "COMPLETED",
                  "NOT ASSESSABLE",
                  "NOT APPLICABLE"
                ]
              }
            ]
          },
          "primary_findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_coverage_note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "class": {
                  "const": "DIAGNOSTIC"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "enum": [
                    "ERROR FOUND",
                    "ERROR NOT FOUND",
                    "NOT ASSESSABLE",
                    "NOT APPLICABLE"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "SYNTHESIS"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "enum": [
                    "COMPLETED",
                    "NOT ASSESSABLE",
                    "NOT APPLICABLE"
                  ]
                }
              }
            }
          }
        ],
        "required": [
          "module",
          "class",
          "status",
          "primary_findings",
          "evidence_coverage_note"
        ]
      }
    },
    "audit_integrity": {
      "type": "object",
      "required": [
        "core_module_coverage",
        "status_finding_ownership",
        "deduplication",
        "not_assessable_evidence_gaps",
        "not_applicable_reasons",
        "human_machine_parity",
        "executive_state_precedence",
        "overall"
      ],
      "properties": {
        "core_module_coverage": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "status_finding_ownership": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "deduplication": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "not_assessable_evidence_gaps": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "not_applicable_reasons": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "human_machine_parity": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT APPLICABLE"
          ]
        },
        "executive_state_precedence": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "overall": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    }
  }
}
